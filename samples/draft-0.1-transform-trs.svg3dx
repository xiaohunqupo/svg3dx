<?xml version="1.0" encoding="UTF-8"?>
<svg version="1.1"
     svg3d="true"
     viewBox="0 0 800 600"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:s3dx="urn:s3dx:draft:0.1">

  <!-- TRS form of s3dx:transform (translate / rotate / scale) with params -->
  <style>
    :root {
      --x: 100;
      --h: 80;
      --yaw: 45;
      --size: 40;
    }
  </style>

  <defs>
    <g id="main">
      <s3dx:box length="var(--size)" width="var(--size)" height="var(--size)"
                lengthVec="1 0 0" widthVec="0 1 0"
                s3dx:transform="translate(var(--x) 0 calc(var(--h) / 2)) rotate(0 var(--yaw) 0) scale(1 1 1)"/>
    </g>
  </defs>

  <s3dx:model id="solid-view" mode="solid" active="true">
    <s3dx:use href="#main"/>
  </s3dx:model>
</svg>
