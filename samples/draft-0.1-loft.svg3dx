<?xml version="1.0" encoding="UTF-8"?>
<svg version="1.1"
     svg3d="true"
     viewBox="0 0 800 600"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:s3dx="urn:s3dx:draft:0.1">

  <style>
    :root { --topRadius: 30; }
  </style>

  <defs>
    <g id="main">
      <s3dx:loft solid="true" ruled="true">
        <s3dx:profile type="polygon"
                      points="-50 -40 0  50 -40 0  50 40 0  -50 40 0"/>
        <s3dx:profile type="circle" center="0 0 80"
                      radius="var(--topRadius)" normal="0 0 1"/>
      </s3dx:loft>
    </g>
  </defs>

  <s3dx:model id="solid-view" mode="solid" active="true">
    <s3dx:use href="#main"/>
  </s3dx:model>
</svg>
