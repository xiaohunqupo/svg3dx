<?xml version="1.0" encoding="UTF-8"?>
<svg version="1.1"
     svg3d="true"
     viewBox="0 0 800 600"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:s3dx="urn:s3dx:draft:0.1">

  <style>
    <!-- 大底小顶 + 较高，中段外形差才明显 -->
    :root { --topR: 12; --H: 160; --gap: 180; --row: 280; }
  </style>

  <defs>
    <g id="main">
      <!-- ========== blend：形状趋近律（中心匀速上升，形状按 f(t) 变） ========== -->
      <!-- 1. linear -->
      <s3dx:loft solid="true" blend="linear"
                 s3dx:transform="matrix(1 0 0 0 1 0 0 0 1 0 0 0)">
        <s3dx:section origin="0 0 0" normal="0 0 1">
          <path d="M -60 -60 L 60 -60 L 60 60 L -60 60 Z"/>
        </s3dx:section>
        <s3dx:section origin="0 0 var(--H)" normal="0 0 1">
          <circle cx="0" cy="0" r="var(--topR)"/>
        </s3dx:section>
      </s3dx:loft>

      <!-- 2. sine：中段仍偏方 -->
      <s3dx:loft solid="true" blend="sine"
                 s3dx:transform="matrix(1 0 0 0 1 0 0 0 1 var(--gap) 0 0)">
        <s3dx:section origin="0 0 0" normal="0 0 1">
          <path d="M -60 -60 L 60 -60 L 60 60 L -60 60 Z"/>
        </s3dx:section>
        <s3dx:section origin="0 0 var(--H)" normal="0 0 1">
          <circle cx="0" cy="0" r="var(--topR)"/>
        </s3dx:section>
      </s3dx:loft>

      <!-- 3. cosine -->
      <s3dx:loft solid="true" blend="cosine"
                 s3dx:transform="matrix(1 0 0 0 1 0 0 0 1 calc(var(--gap) * 2) 0 0)">
        <s3dx:section origin="0 0 0" normal="0 0 1">
          <path d="M -60 -60 L 60 -60 L 60 60 L -60 60 Z"/>
        </s3dx:section>
        <s3dx:section origin="0 0 var(--H)" normal="0 0 1">
          <circle cx="0" cy="0" r="var(--topR)"/>
        </s3dx:section>
      </s3dx:loft>

      <!-- 4. tan：下部几乎保持大方 -->
      <s3dx:loft solid="true" blend="tan"
                 s3dx:transform="matrix(1 0 0 0 1 0 0 0 1 calc(var(--gap) * 3) 0 0)">
        <s3dx:section origin="0 0 0" normal="0 0 1">
          <path d="M -60 -60 L 60 -60 L 60 60 L -60 60 Z"/>
        </s3dx:section>
        <s3dx:section origin="0 0 var(--H)" normal="0 0 1">
          <circle cx="0" cy="0" r="var(--topR)"/>
        </s3dx:section>
      </s3dx:loft>

      <!-- 5. cotan：下部很快变圆 -->
      <s3dx:loft solid="true" blend="cotan"
                 s3dx:transform="matrix(1 0 0 0 1 0 0 0 1 calc(var(--gap) * 4) 0 0)">
        <s3dx:section origin="0 0 0" normal="0 0 1">
          <path d="M -60 -60 L 60 -60 L 60 60 L -60 60 Z"/>
        </s3dx:section>
        <s3dx:section origin="0 0 var(--H)" normal="0 0 1">
          <circle cx="0" cy="0" r="var(--topR)"/>
        </s3dx:section>
      </s3dx:loft>

      <!-- ========== solid ========== -->
      <s3dx:loft solid="true" blend="linear"
                 s3dx:transform="matrix(1 0 0 0 1 0 0 0 1 0 var(--row) 0)">
        <s3dx:section origin="0 0 0" normal="0 0 1">
          <path d="M -60 -60 L 60 -60 L 60 60 L -60 60 Z"/>
        </s3dx:section>
        <s3dx:section origin="0 0 var(--H)" normal="0 0 1">
          <circle cx="0" cy="0" r="var(--topR)"/>
        </s3dx:section>
      </s3dx:loft>

      <s3dx:loft solid="false" blend="linear"
                 s3dx:transform="matrix(1 0 0 0 1 0 0 0 1 var(--gap) var(--row) 0)">
        <s3dx:section origin="0 0 0" normal="0 0 1">
          <path d="M -60 -60 L 60 -60 L 60 60 L -60 60 Z"/>
        </s3dx:section>
        <s3dx:section origin="0 0 var(--H)" normal="0 0 1">
          <circle cx="0" cy="0" r="var(--topR)"/>
        </s3dx:section>
      </s3dx:loft>
    </g>
  </defs>

  <s3dx:model id="solid-view" mode="solid" active="true">
    <s3dx:use href="#main"/>
  </s3dx:model>

  <!-- Labels: blend / solid (gap=180, row=280). -->
  <g fill="#1f2937" font-family="sans-serif" font-size="12" text-anchor="middle">
    <text x="360" y="-50" font-size="16">loft</text>

    <text x="0" y="-28">blend=linear</text>
    <text x="0" y="-44" font-size="9">uniform f(t)=t</text>

    <text x="180" y="-28">blend=sine</text>
    <text x="180" y="-44" font-size="9">mid stays squarer</text>

    <text x="360" y="-28">blend=cosine</text>
    <text x="360" y="-44" font-size="9">ease in/out</text>

    <text x="540" y="-28">blend=tan</text>
    <text x="540" y="-44" font-size="9">base stays square</text>

    <text x="720" y="-28">blend=cotan</text>
    <text x="720" y="-44" font-size="9">rounds early</text>

    <text x="0" y="250">solid=true</text>
    <text x="0" y="234" font-size="9">blend=linear</text>

    <text x="180" y="250">solid=false</text>
    <text x="180" y="234" font-size="9">open shell</text>
  </g>
</svg>
