<?xml version="1.0" encoding="UTF-8"?>
<svg version="1.1"
     svg3d="true"
     viewBox="0 0 800 600"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:s3dx="urn:s3dx:draft:0.1">

  <style>
    :root { --angle: 360; }
  </style>

  <defs>
    <g id="main">
      <!-- Section in default XY (normal +Z); u = radius, v = height along axis Y -->
      <s3dx:revolve axisOrigin="0 0 0" axisDir="0 1 0" angle="var(--angle)">
        <s3dx:section>
          <path d="M 40 0 L 80 0 L 80 60 L 40 40 Z"/>
        </s3dx:section>
      </s3dx:revolve>
    </g>
  </defs>

  <s3dx:model id="solid-view" mode="solid" active="true">
    <s3dx:use href="#main"/>
  </s3dx:model>
</svg>
