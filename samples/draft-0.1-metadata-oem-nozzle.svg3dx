<?xml version="1.0" encoding="UTF-8"?>
<!--
  OEM nozzle metadata demo.
  Vendor attribute schema: urn:acme:equipment:1.0 (declared below as xmlns:acme).
  Geometry: svg3dx. Association: SVG <metadata> as child of the host group.
-->
<svg version="1.1"
     svg3d="true"
     viewBox="0 0 800 600"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:s3dx="urn:s3dx:draft:0.1"
     xmlns:acme="urn:acme:equipment:1.0">

  <!-- Document-level: vendor profile; spec path is relative to the svg3dx repo root -->
  <metadata>
    <acme:profile version="1.0"
                  spec="namespaces/acme/acme.equipment.1.0.xml"
                  productLine="VD-series"/>
  </metadata>

  <defs>
    <g id="vessel-vd1200">
      <!-- Shell: large vertical cylinder -->
      <g id="shell">
        <metadata>
          <acme:equipment tag="V-101"
                          model="VD-1200"
                          manufacturer="ACME"/>
        </metadata>
        <s3dx:cylinder diameter="1200"
                       bottomCenterPt="0 0 0"
                       topCenterPt="0 0 2000"/>
      </g>

      <!-- Nozzle: small cylinder on the side (+X), mid-height.
           Local +Z maps to world +X; origin on shell OD (r=600) at z=1000. -->
      <g id="nozzle-n1"
         s3dx:transform="matrix(0 0 -1 0 1 0 1 0 0 600 0 1000)">
        <metadata>
          <acme:nozzle tag="N1"
                       nominalSize="DN100"
                       rating="PN16"
                       facing="RF"
                       endType="WN"
                       service="cooling-water"
                       orientation="radial"/>
          <acme:note>Shop hydrotest with shell; do not blind independently.</acme:note>
        </metadata>
        <s3dx:cylinder diameter="100"
                       bottomCenterPt="0 0 0"
                       topCenterPt="0 0 200"/>
      </g>
    </g>
  </defs>

  <s3dx:model id="solid-view" mode="solid" active="true">
    <s3dx:use href="#vessel-vd1200"/>
  </s3dx:model>
</svg>
