<?xml version="1.0" encoding="UTF-8"?>
<svg version="1.1"
     svg3d="true"
     viewBox="0 0 800 600"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:s3dx="urn:s3dx:draft:0.1">

  <style>
    :root { --radius: 80; --angle: 120; }
  </style>

  <defs>
    <g id="main">
      <!-- Angle form -->
      <s3dx:arc form="angles" center="0 0 0" normal="0 0 1" radius="var(--radius)"
                xDir="1 0 0" startAngle="0" angle="var(--angle)"/>
      <!-- from/to form (minor arc in YZ plane) -->
      <s3dx:arc form="ends" center="0 0 100" normal="1 0 0" radius="60"
                from="0 0 40" to="0 60 100"/>
    </g>
  </defs>

  <s3dx:model id="solid-view" mode="solid" active="true">
    <s3dx:use href="#main"/>
  </s3dx:model>
</svg>
