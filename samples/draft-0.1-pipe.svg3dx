<?xml version="1.0" encoding="UTF-8"?>
<svg version="1.1"
     svg3d="true"
     viewBox="0 0 800 600"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:s3dx="urn:s3dx:draft:0.1">

  <style>
    <!-- Z-up：沿 +X 再立起 +Z -->
    :root { --radius: 20; --innerRadius: 16; --bend: 80; }
  </style>

  <defs>
    <g id="main">
      <s3dx:pipe form="child" radius="var(--radius)" innerRadius="var(--innerRadius)"
                 outerCorner="round" innerCorner="round"
                 outerCornerRadius="var(--bend)" innerCornerRadius="var(--bend)">
        <s3dx:path form="polyline" points="0 0 0  300 0 0  300 0 300"/>
      </s3dx:pipe>
    </g>
  </defs>

  <s3dx:model id="solid-view" mode="solid" active="true">
    <s3dx:use href="#main"/>
  </s3dx:model>
</svg>
