<?xml version="1.0" encoding="UTF-8"?>
<svg version="1.1"
     svg3d="true"
     viewBox="0 0 800 600"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:s3dx="urn:s3dx:draft:0.1">

  <style>
    :root { --radius: 20; --innerRadius: 16; }
  </style>

  <defs>
    <g id="main">
      <s3dx:pipe radius="var(--radius)" innerRadius="var(--innerRadius)"
                 path="0 0 0  300 0 0  300 0 200"/>
    </g>
  </defs>

  <s3dx:model id="solid-view" mode="solid" active="true">
    <s3dx:use href="#main"/>
  </s3dx:model>
</svg>
