<?xml version="1.0" encoding="UTF-8"?>
<svg version="1.1"
     svg3d="true"
     viewBox="0 0 800 600"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:s3dx="urn:s3dx:draft:0.1">

  <style>
    :root { --bend: 75; }
  </style>

  <defs>
    <g id="main">
      <!-- Polyline shorthand -->
      <s3dx:path form="polyline" points="0 40 0  120 40 0  120 40 80  40 40 80"/>

      <!-- 90° composite: line + arc + line (G1) -->
      <s3dx:path form="segments">
        <s3dx:line from="0 0 0" to="200 0 0"/>
        <s3dx:arc form="ends" center="200 0 var(--bend)" normal="0 -1 0"
                  radius="var(--bend)"
                  from="200 0 0" to="275 0 var(--bend)"/>
        <s3dx:line from="275 0 var(--bend)" to="275 0 200"/>
      </s3dx:path>
    </g>
  </defs>

  <s3dx:model id="solid-view" mode="solid" active="true">
    <s3dx:use href="#main"/>
  </s3dx:model>
</svg>
