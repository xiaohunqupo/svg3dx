<?xml version="1.0" encoding="UTF-8"?>
<svg version="1.1"
     svg3d="true"
     viewBox="0 0 800 600"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:s3dx="urn:s3dx:draft:0.1">
  <style>
    /* LOD: 0 = coarse mesh, 1 = full Stanford Bunny */
    :root { --LOD: 1; }
  </style>

  <!-- Same logical model; if selects tessellation LOD via distinct glTF assets -->
  <defs>
    <g id="bunny">
      <s3dx:if test="var(--LOD) = 0">
        <s3dx:gltf href="assets/bunny-lod0.glb" fill="0.82 0.78 0.72 1"/>
      </s3dx:if>
      <s3dx:if test="var(--LOD) = 1">
        <s3dx:gltf href="assets/bunny.glb" fill="0.82 0.78 0.72 1"/>
      </s3dx:if>
    </g>
  </defs>

  <s3dx:model id="solid-view" mode="solid" active="true">
    <s3dx:use href="#bunny"/>
  </s3dx:model>
</svg>
