<?xml version="1.0" encoding="UTF-8"?>
<svg version="1.1"
     svg3d="true"
     viewBox="0 0 800 600"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:s3dx="urn:s3dx:draft:0.1">

  <!-- 在给定点列上实例化 box；size / height 可外部调节 -->
  <style>
    :root { --size: 30; --height: 60; }
  </style>

  <defs>
    <g id="main">
      <s3dx:loop-points points="0 0 0  100 0 0  100 100 0  0 100 0">
        <s3dx:box length="var(--size)" width="var(--size)" height="var(--height)"
                  lengthVec="1 0 0" widthVec="0 1 0"
                  s3dx:transform="matrix(1 0 0 0 1 0 0 0 1 var(--loop-value))"/>
      </s3dx:loop-points>
    </g>
  </defs>

  <s3dx:model id="solid-view" mode="solid" active="true">
    <s3dx:use href="#main"/>
  </s3dx:model>
</svg>
