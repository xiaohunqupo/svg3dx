<?xml version="1.0" encoding="UTF-8"?>
<svg version="1.1"
     svg3d="true"
     viewBox="0 0 800 600"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:s3dx="urn:s3dx:draft:0.1">

  <!-- 沿 X 方向按 range 阵列 box；spacing 控制间距 -->
  <style>
    :root { --count: 4; --spacing: 50; --size: 20; --height: 80; }
  </style>

  <defs>
    <g id="main">
      <s3dx:loop-range start="0" end="var(--count)" step="1">
        <s3dx:box length="var(--size)" width="var(--size)" height="var(--height)"
                  lengthVec="1 0 0" widthVec="0 1 0"
                  s3dx:transform="matrix(1 0 0 0 1 0 0 0 1 calc(var(--loop-value) * var(--spacing)) 0 0)"/>
      </s3dx:loop-range>
    </g>
  </defs>

  <s3dx:model id="solid-view" mode="solid" active="true">
    <s3dx:use href="#main"/>
  </s3dx:model>
</svg>
