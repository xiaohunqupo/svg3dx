<?xml version="1.0" encoding="UTF-8"?>
<svg version="1.1"
     svg3d="true"
     viewBox="0 0 800 600"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:s3dx="urn:s3dx:draft:0.1">

  <style>
    :root { --pathLen: 200; }
  </style>

  <defs>
    <g id="main">
      <s3dx:sweep orient="frenet" solid="true">
        <s3dx:profile type="polygon"
                      points="-10 -5 0  10 -5 0  10 5 0  -10 5 0"/>
        <s3dx:path points="0 0 0  var(--pathLen) 0 0  var(--pathLen) 0 150  50 0 150"/>
      </s3dx:sweep>
    </g>
  </defs>

  <s3dx:model id="solid-view" mode="solid" active="true">
    <s3dx:use href="#main"/>
  </s3dx:model>
</svg>
