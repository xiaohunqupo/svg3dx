<?xml version="1.0" encoding="UTF-8"?>
<svg version="1.1"
     svg3d="true"
     viewBox="0 0 800 600"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:s3dx="urn:s3dx:draft:0.1">

  <style>
    <!-- 世界坐标 Z-up：水平弯在 XY 面（Z=0），+Z 为高度 -->
    :root { --pathLen: 100; --bendY: 140; --bend: 55; --row: 400; }
  </style>

  <defs>
    <g id="main">
      <!-- ========== corner：轨迹折角面衔接（XY 水平弯） ========== -->
      <!-- 1. arc -->
      <s3dx:sweep orient="frenet" solid="true" corner="arc" cornerRadius="var(--bend)"
                  s3dx:transform="matrix(1 0 0 0 1 0 0 0 1 0 0 0)">
        <s3dx:section>
          <path d="M -22 -4 L 22 -4 L 22 4 L -22 4 Z"/>
        </s3dx:section>
        <s3dx:path form="polyline" points="0 0 0  var(--pathLen) 0 0  var(--pathLen) var(--bendY) 0"/>
      </s3dx:sweep>

      <!-- 2. chamfer -->
      <s3dx:sweep orient="frenet" solid="true" corner="chamfer" cornerRadius="var(--bend)"
                  s3dx:transform="matrix(1 0 0 0 1 0 0 0 1 300 0 0)">
        <s3dx:section>
          <path d="M -22 -4 L 22 -4 L 22 4 L -22 4 Z"/>
        </s3dx:section>
        <s3dx:path form="polyline" points="0 0 0  var(--pathLen) 0 0  var(--pathLen) var(--bendY) 0"/>
      </s3dx:sweep>

      <!-- 3. sharp -->
      <s3dx:sweep orient="frenet" solid="true" corner="sharp"
                  s3dx:transform="matrix(1 0 0 0 1 0 0 0 1 600 0 0)">
        <s3dx:section>
          <path d="M -22 -4 L 22 -4 L 22 4 L -22 4 Z"/>
        </s3dx:section>
        <s3dx:path form="polyline" points="0 0 0  var(--pathLen) 0 0  var(--pathLen) var(--bendY) 0"/>
      </s3dx:sweep>

      <!-- 4. miter -->
      <s3dx:sweep orient="frenet" solid="true" corner="miter"
                  s3dx:transform="matrix(1 0 0 0 1 0 0 0 1 900 0 0)">
        <s3dx:section>
          <path d="M -22 -4 L 22 -4 L 22 4 L -22 4 Z"/>
        </s3dx:section>
        <s3dx:path form="polyline" points="0 0 0  var(--pathLen) 0 0  var(--pathLen) var(--bendY) 0"/>
      </s3dx:sweep>

      <!-- ========== orient：截面朝向（XY 水平弯 + 旗形截面） ========== -->
      <!-- 旗形长边在 u：立起≈高墙，躺平≈矮板。 -->
      <!-- 5. frenet：随弯侧倾 -->
      <s3dx:sweep orient="frenet" solid="true" corner="arc" cornerRadius="var(--bend)"
                  s3dx:transform="matrix(1 0 0 0 1 0 0 0 1 0 var(--row) 0)">
        <s3dx:section>
          <path d="M 0 -4 L 50 -4 L 50 4 L 12 4 L 12 18 L 0 18 Z"/>
        </s3dx:section>
        <s3dx:path form="polyline" points="0 0 0  var(--pathLen) 0 0  var(--pathLen) var(--bendY) 0"/>
      </s3dx:sweep>

      <!-- 6. fixed：refDir=+Z → 截面 +u 朝上 → 长边立起成墙 -->
      <s3dx:sweep orient="fixed" refDir="0 0 1" solid="true" corner="arc" cornerRadius="var(--bend)"
                  s3dx:transform="matrix(1 0 0 0 1 0 0 0 1 300 var(--row) 0)">
        <s3dx:section>
          <path d="M 0 -4 L 50 -4 L 50 4 L 12 4 L 12 18 L 0 18 Z"/>
        </s3dx:section>
        <s3dx:path form="polyline" points="0 0 0  var(--pathLen) 0 0  var(--pathLen) var(--bendY) 0"/>
      </s3dx:sweep>

      <!-- 7. parallel：refDir=+Z → 截面 +v 保持朝上（相对 fixed 像“放倒/立起”差） -->
      <s3dx:sweep orient="parallel" refDir="0 0 1" solid="true" corner="arc" cornerRadius="var(--bend)"
                  s3dx:transform="matrix(1 0 0 0 1 0 0 0 1 600 var(--row) 0)">
        <s3dx:section>
          <path d="M 0 -4 L 50 -4 L 50 4 L 12 4 L 12 18 L 0 18 Z"/>
        </s3dx:section>
        <s3dx:path form="polyline" points="0 0 0  var(--pathLen) 0 0  var(--pathLen) var(--bendY) 0"/>
      </s3dx:sweep>

      <!-- ========== solid ========== -->
      <!-- 8. solid=true -->
      <s3dx:sweep orient="frenet" solid="true" corner="arc" cornerRadius="var(--bend)"
                  s3dx:transform="matrix(1 0 0 0 1 0 0 0 1 0 calc(var(--row) * 2) 0)">
        <s3dx:section>
          <path d="M -22 -4 L 22 -4 L 22 4 L -22 4 Z"/>
        </s3dx:section>
        <s3dx:path form="polyline" points="0 0 0  var(--pathLen) 0 0  var(--pathLen) var(--bendY) 0"/>
      </s3dx:sweep>

      <!-- 9. solid=false -->
      <s3dx:sweep orient="frenet" solid="false" corner="arc" cornerRadius="var(--bend)"
                  s3dx:transform="matrix(1 0 0 0 1 0 0 0 1 300 calc(var(--row) * 2) 0)">
        <s3dx:section>
          <path d="M -22 -4 L 22 -4 L 22 4 L -22 4 Z"/>
        </s3dx:section>
        <s3dx:path form="polyline" points="0 0 0  var(--pathLen) 0 0  var(--pathLen) var(--bendY) 0"/>
      </s3dx:sweep>
    </g>
  </defs>

  <s3dx:model id="solid-view" mode="solid" active="true">
    <s3dx:use href="#main"/>
  </s3dx:model>

  <!-- Labels sit south of each row (smaller Y than geometry) with clear gaps. -->
  <g fill="#2563eb" font-family="sans-serif" font-size="14" text-anchor="middle">
    <text x="450" y="-90" font-size="18">sweep</text>

    <!-- row0 at Y=0: labels above -->
    <text x="50" y="-55">corner=arc</text>
    <text x="50" y="-72" font-size="10">cornerRadius=55</text>

    <text x="350" y="-55">corner=chamfer</text>
    <text x="350" y="-72" font-size="10">cornerRadius=55</text>

    <text x="650" y="-55">corner=sharp</text>
    <text x="650" y="-72" font-size="10">no radius</text>

    <text x="950" y="-55">corner=miter</text>
    <text x="950" y="-72" font-size="10">bevel join</text>

    <!-- row1 at Y=400: labels in the gap after row0 bend (~140) -->
    <text x="50" y="345">orient=frenet</text>
    <text x="50" y="328" font-size="10">banks with bend</text>

    <text x="350" y="345">orient=fixed</text>
    <text x="350" y="328" font-size="10">refDir=0 0 1</text>

    <text x="650" y="345">orient=parallel</text>
    <text x="650" y="328" font-size="10">refDir=0 0 1</text>

    <!-- row2 at Y=800 -->
    <text x="50" y="745">solid=true</text>
    <text x="50" y="728" font-size="10">capped solid</text>

    <text x="350" y="745">solid=false</text>
    <text x="350" y="728" font-size="10">open shell</text>
  </g>
</svg>
