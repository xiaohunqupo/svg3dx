<?xml version="1.0" encoding="UTF-8"?>
<svg version="1.1"
     svg3d="true"
     viewBox="0 0 800 600"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:s3dx="urn:s3dx:draft:0.1">

  <style>
    :root { --length: 60; }
  </style>

  <defs>
    <g id="main">
      <s3dx:extrude dir="0 0 1" length="var(--length)">
        <s3dx:profile type="polygon"
                      points="0 0 0  100 0 0  100 50 0  0 50 0"/>
      </s3dx:extrude>
    </g>
  </defs>

  <s3dx:model id="solid-view" mode="solid" active="true">
    <s3dx:use href="#main"/>
  </s3dx:model>
</svg>
