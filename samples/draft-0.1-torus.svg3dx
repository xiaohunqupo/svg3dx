<?xml version="1.0" encoding="UTF-8"?>
<svg version="1.1"
     svg3d="true"
     viewBox="0 0 800 600"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:s3dx="urn:s3dx:draft:0.1">

  <style>
    :root { --diameter1: 120; --diameter2: 30; --angle: 360; }
  </style>

  <defs>
    <g id="main">
      <s3dx:torus diameter1="var(--diameter1)" diameter2="var(--diameter2)"
                  angle="var(--angle)"
                  torusCenterPt="0 0 0" normal="0 0 1"/>
    </g>
  </defs>

  <s3dx:model id="solid-view" mode="solid" active="true">
    <s3dx:use href="#main"/>
  </s3dx:model>
</svg>
